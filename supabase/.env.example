# Local Supabase stack secrets — COPY to supabase/.env.local and fill in.
# supabase/.env.local is gitignored; NEVER commit real credentials.
#
# Used by scripts/start-stack.ps1 to configure the local stack's Google
# provider (Auth). Get these from Google Cloud Console → APIs & Services →
# Credentials → your OAuth 2.0 Client.
#
# The Google Cloud OAuth client must be type "Web application" with this
# Authorized redirect URI added:
#   http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

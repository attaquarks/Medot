# =============================================================================
# AIA — environment template.  Copy to `.env` and fill in.  NEVER commit `.env`.
# The onboarding wizard writes most of these for you; this file documents them.
# =============================================================================

# ---- Core ----
AIA_ENV=local                       # local | hosted
AIA_TENANT_ID=default               # single-user installs leave this as "default"
AIA_LOG_LEVEL=INFO

# ---- Secrets / encryption -----------------------------------------------------
# The MASTER KEY encrypts every OAuth token & credential at rest (envelope encryption).
# On a laptop install it is generated once and stored in the OS keychain automatically.
# Only set this explicitly for headless/server installs (base64 urlsafe 32 bytes).
# AIA_MASTER_KEY=

# ---- Datastore ----------------------------------------------------------------
POSTGRES_USER=aia
POSTGRES_PASSWORD=change-me-in-onboarding
POSTGRES_DB=aia
DATABASE_URL=postgresql+asyncpg://aia:change-me-in-onboarding@postgres:5432/aia
REDIS_URL=redis://redis:6379/0

# ---- LLM routing (hybrid) -----------------------------------------------------
# Local model is the default; cloud is used only as a fallback for hard tasks
# or when LLM_FORCE_CLOUD=1.  Leave cloud keys blank to run 100% offline.
OLLAMA_BASE_URL=http://ollama:11434
LLM_LOCAL_MODEL=ollama/llama3.1:8b-instruct-q4_K_M
LLM_CLOUD_MODEL=openai/gpt-4o-mini
LLM_EMBEDDING_MODEL=ollama/nomic-embed-text
LLM_FORCE_CLOUD=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- WhatsApp -----------------------------------------------------------------
# provider: baileys (default, QR pairing, personal use) | cloud (Meta Business API)
WHATSAPP_PROVIDER=baileys
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:8085
# Cloud API (only if WHATSAPP_PROVIDER=cloud)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=

# ---- OAuth client apps (per provider; set via onboarding) ---------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# ---- Phone / voice ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=

# ---- Nutrition providers ------------------------------------------------------
NUTRITION_PROVIDER=usda             # usda | nutritionix | openfoodfacts
USDA_API_KEY=                       # free at https://fdc.nal.usda.gov/api-key-signup.html
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# ---- Task manager -------------------------------------------------------------
TASKS_PROVIDER=local                # local | notion | todoist | google_tasks
NOTION_TOKEN=
TODOIST_TOKEN=

# ---- Onboarding wizard --------------------------------------------------------
ONBOARDING_PORT=8088
PUBLIC_BASE_URL=http://localhost:8088   # OAuth redirect base

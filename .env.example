# =============================================================================
# AIA — environment template.  Copy to `.env` and fill in.  NEVER commit `.env`.
# The onboarding wizard writes most of these for you; this file documents them.
# =============================================================================

# ---- Core ----
AIA_ENV=local                       # local | hosted
AIA_TENANT_ID=default               # single-user installs leave this as "default"
AIA_LOG_LEVEL=INFO

# ---- Secrets / encryption -----------------------------------------------------
# The MASTER KEY encrypts every OAuth token & credential at rest (envelope encryption).
# On a laptop install it is generated once and stored in the OS keychain automatically.
# Only set this explicitly for headless/server installs (base64 urlsafe 32 bytes).
# AIA_MASTER_KEY=

# ---- Datastore ----------------------------------------------------------------
POSTGRES_USER=aia
POSTGRES_PASSWORD=change-me-in-onboarding
POSTGRES_DB=aia
DATABASE_URL=postgresql+asyncpg://aia:change-me-in-onboarding@postgres:5432/aia
REDIS_URL=redis://redis:6378/0

# ---- LLM routing (hybrid) -----------------------------------------------------
# Local model is the default; cloud is used only as a fallback for hard tasks
# or when LLM_FORCE_CLOUD=1.  Leave cloud keys blank to run 100% offline.
#
# Ollama supports two backends through the same URL:
#   1. Native host Ollama  ->  OLLAMA_BASE_URL=http://host.docker.internal:11434
#   2. Ollama Cloud        ->  OLLAMA_BASE_URL=https://ollama.com
#                              (requires `ollama signin` on the host)
# Any model you can `ollama pull <name>` (incl. `name:cloud` variants) can be
# used; just put the `ollama/`-prefixed tag below.  Run `GET /models` on the
# gateway to see what's available right now.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Pick a chat model.  Examples:
#   ollama/llama3.1:8b-instruct-q4_K_M     (fully offline, ~4.7 GB)
#   ollama/nemotron-3-super:cloud          (NVIDIA, hosted by Ollama Cloud)
#   ollama/deepseek-v3.1:cloud             (Ollama Cloud)
#   ollama/qwen3-coder:cloud               (Ollama Cloud)
LLM_LOCAL_MODEL=ollama/nemotron-3-super:cloud
LLM_CLOUD_MODEL=openai/gpt-4o-mini
# Embedding model (used for long-term semantic memory).  nomic-embed-text is
# small, fast and also available on Ollama Cloud with the same name.
LLM_EMBEDDING_MODEL=ollama/nomic-embed-text
LLM_FORCE_CLOUD=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OLLAMA_API_KEY is only needed when OLLAMA_BASE_URL points to Ollama Cloud
# directly. Native host Ollama usually does not need this.
OLLAMA_API_KEY=

# ---- WhatsApp -----------------------------------------------------------------
# provider: baileys (default, QR pairing, personal use) | cloud (Meta Business API)
WHATSAPP_PROVIDER=baileys
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:8085
# Cloud API (only if WHATSAPP_PROVIDER=cloud)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=

# ---- OAuth client apps (per provider; set via onboarding) ---------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# ---- Phone / voice ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=

# ---- Nutrition providers ------------------------------------------------------
NUTRITION_PROVIDER=usda             # usda | nutritionix | openfoodfacts
USDA_API_KEY=                       # free at https://fdc.nal.usda.gov/api-key-signup.html
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# ---- Task manager -------------------------------------------------------------
TASKS_PROVIDER=local                # local | notion | todoist | google_tasks
NOTION_TOKEN=
TODOIST_TOKEN=

# ---- Onboarding wizard --------------------------------------------------------
ONBOARDING_PORT=8088
PUBLIC_BASE_URL=http://localhost:8088   # OAuth redirect base

# ---- Owner & proactive flows ----------------------------------------------------
# IANA timezone for scheduled messages (daily brief, check-ins) and calendar maths.
AIA_TIMEZONE=UTC
# The owner's WhatsApp id (digits). Falls back to the first WHATSAPP_ALLOWED_NUMBERS
# entry when unset. Escalations and proactive briefs go here.
# AIA_PRINCIPAL_WHATSAPP=
# How often (seconds) the email poller checks the connected mailbox for new mail.
EMAIL_POLL_SECONDS=180

# ---- Email / Calendar provider selection ---------------------------------------
# Which connected account the business agent uses.
EMAIL_PROVIDER=gmail                  # gmail | outlook
CALENDAR_PROVIDER=google              # google | outlook

# ---- Notion tasks (only when TASKS_PROVIDER=notion) ----------------------------
# A Notion database with properties: Name (title), Done (checkbox), Due (date).
NOTION_DATABASE_ID=

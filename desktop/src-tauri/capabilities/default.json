{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Medot main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:event:default",
    "deep-link:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "medot-runtime", "sidecar": true }
      ]
    }
  ]
}
